<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>uk.gov.moj.cpp.progression</groupId>
        <artifactId>progression-parent</artifactId>
        <version>25.104.0-M1-SNAPSHOT</version>
    </parent>
    <artifactId>progression-event</artifactId>
    <packaging>pom</packaging>
    <modules>
        <module>progression-event-indexer</module>
        <module>progression-event-listener</module>
        <module>progression-event-processor</module>
    </modules>
    <build>
        <plugins>
            <plugin>
                <groupId>uk.gov.justice.framework-generators</groupId>
                <artifactId>messaging-adapter-generator-plugin</artifactId>
                <version>${framework.version}</version>
                <dependencies>
                    <!-- raml-parser needs the pre-EE9 javax.xml.bind.SchemaOutputResolver on the
                         plugin classpath; without it the generator dies with NoClassDefFoundError -->
                    <dependency>
                        <groupId>jakarta.xml.bind</groupId>
                        <artifactId>jakarta.xml.bind-api</artifactId>
                        <version>${jakarta.xml.bind-api.raml.version}</version>
                    </dependency>
                    <!-- Jakarta JSON-P provider for the generator's build-time JSON processing;
                         without it the plugin fails with "Provider org.eclipse.parsson.JsonProviderImpl not found" -->
                    <dependency>
                        <groupId>org.eclipse.parsson</groupId>
                        <artifactId>parsson</artifactId>
                        <version>${parsson.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>uk.gov.moj.cpp.progression</groupId>
                        <artifactId>progression-event-sources</artifactId>
                        <classifier>yaml</classifier>
                        <version>${project.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>uk.gov.justice.framework-generators</groupId>
                <artifactId>messaging-client-generator-plugin</artifactId>
                <dependencies>
                    <!-- raml-parser needs the pre-EE9 javax.xml.bind.SchemaOutputResolver on the
                         plugin classpath; without it the generator dies with NoClassDefFoundError -->
                    <dependency>
                        <groupId>jakarta.xml.bind</groupId>
                        <artifactId>jakarta.xml.bind-api</artifactId>
                        <version>${jakarta.xml.bind-api.raml.version}</version>
                    </dependency>
                    <!-- Jakarta JSON-P provider for the generator's build-time JSON processing;
                         without it the plugin fails with "Provider org.eclipse.parsson.JsonProviderImpl not found" -->
                    <dependency>
                        <groupId>org.eclipse.parsson</groupId>
                        <artifactId>parsson</artifactId>
                        <version>${parsson.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>jakarta.platform</groupId>
                        <artifactId>jakarta.jakartaee-api</artifactId>
                        <version>${javaee-api.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>uk.gov.moj.cpp.progression</groupId>
                        <artifactId>progression-event-sources</artifactId>
                        <classifier>yaml</classifier>
                        <version>${project.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>