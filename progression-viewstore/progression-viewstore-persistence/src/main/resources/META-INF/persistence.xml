<?xml version="1.0" encoding="UTF-8" ?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="progression-persistence-unit">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <jta-data-source>java:/DS.progression</jta-data-source>
        <class>uk.gov.moj.cpp.progression.persistence.entity.CaseProgressionDetail</class>
        <properties>
            <!-- CourtRegisterRequestRepository's greatest-per-group queries use HQL's row-value
                 constructor, "(a.registerTime, a.hearingId) IN (select max(...), ... )". Hibernate 7
                 rejects that under strict JPA compliance (StrictJpaComplianceViolation), which only
                 surfaces at runtime on the query - the build and unit tests stay green. Allowing the
                 extension preserves the queries exactly rather than rewriting them. -->
            <property name="hibernate.jpa.compliance.query" value="false"/>
        </properties>
    </persistence-unit>

</persistence>
