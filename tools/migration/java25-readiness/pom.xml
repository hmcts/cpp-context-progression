<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>uk.gov.moj.cpp.common</groupId><artifactId>service-parent-pom</artifactId>
    <version>25.104.6</version><relativePath/>
  </parent>
  <groupId>uk.gov.moj.cpp.progression.readiness</groupId>
  <artifactId>progression-java25-readiness</artifactId><version>25.104.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>Progression Java 25 standalone readiness</name>
  <!-- Independent probe only; no Progression modules, deployment or migration goals. -->
  <dependencies>
    <dependency>
      <groupId>jakarta.platform</groupId><artifactId>jakarta.jakartaee-api</artifactId><scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter-api</artifactId><scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter-engine</artifactId><scope>test</scope>
    </dependency>
    <dependency>
      <groupId>uk.gov.justice.services</groupId><artifactId>persistence-jpa</artifactId>
      <version>25.104.6</version><scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.hibernate.orm</groupId><artifactId>hibernate-core</artifactId><scope>test</scope>
    </dependency>
    <!-- Resolve and inspect both MI artifacts; do not unpack or claim their contract tests executed. -->
    <dependency>
      <groupId>uk.gov.moj.cpp.mi.reportdata</groupId><artifactId>mireportdata-progression-event-listener</artifactId>
      <version>RELEASE</version><classifier>listener-tests</classifier><scope>test</scope>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>uk.gov.moj.cpp.mi.reportdata</groupId><artifactId>mireportdata-progression-event-listener</artifactId>
      <version>RELEASE</version><classifier>processor-tests</classifier><scope>test</scope>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
  </dependencies>
  <build><plugins>
    <plugin>
      <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
      <configuration>
        <release>25</release>
        <!-- Matches the selected common BOM's Lombok; processor discovery is explicit for JDK25. -->
        <annotationProcessorPaths><path>
          <groupId>org.projectlombok</groupId><artifactId>lombok</artifactId>
          <version>1.18.40</version>
        </path></annotationProcessorPaths>
      </configuration>
    </plugin>
    <plugin>
      <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
      <configuration><failIfNoTests>true</failIfNoTests></configuration>
    </plugin>
  </plugins></build>
</project>
