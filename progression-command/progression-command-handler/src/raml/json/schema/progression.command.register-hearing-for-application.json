  "type": "object",
  "description": "Register a hearing against an application so that application edits reach it",
  "properties": {
    "applicationId": {
      "description": "Application Id",
      "$ref": "http://justice.gov.uk/domain/core/common/definitions.json#/definitions/uuid"
    },
    "hearingId": {
      "description": "Hearing Id",
