{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://moj.gov.uk/cpp/progression/common/statdec-application-status-summary.json",
  "type": "object",
  "description": "Category and status of a STAT DEC, REOPEN or APPEAL application linked to a case, used for the CAAG labels",
  "properties": {
    "applicationId": {
      "$ref": "http://justice.gov.uk/domain/core/common/definitions.json#/definitions/uuid"
    },
    "applicationTypeCode": {
      "type": "string"
    },
    "applicationCategory": {
      "$ref": "http://moj.gov.uk/cpp/progression/enum-def.json#/definitions/statdecApplicationCategory"
    },
    "status": {
      "$ref": "http://moj.gov.uk/cpp/progression/enum-def.json#/definitions/statdecApplicationLabelStatus"
    },
    "defendantOffences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "id": "http://moj.gov.uk/cpp/progression/common/statdec-application-defendant-offences.json",
        "type": "object",
        "properties": {
          "defendantId": {
            "$ref": "http://justice.gov.uk/domain/core/common/definitions.json#/definitions/uuid"
          },
          "offenceIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "http://justice.gov.uk/domain/core/common/definitions.json#/definitions/uuid"
            }
          }
        }
      }
    }
  },
  "required": [
    "applicationId",
    "applicationCategory",
    "status"
  ],
  "additionalProperties": false
}
