{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://justice.gov.uk/core/courts/progression.event.court-application-deleted-bdf.json",
  "type": "object",
  "description": "court application deleted by BDF",
  "properties": {
    "applicationId": {
      "$ref": "http://justice.gov.uk/domain/core/common/definitions.json#/definitions/uuid"
    },
    "caseIds": {
      "type": "array",
      "description": "ids of the prosecution cases the deleted application was linked to",
      "items": {
        "$ref": "http://justice.gov.uk/domain/core/common/definitions.json#/definitions/uuid"
      }
    }
  },
  "required": [
    "applicationId"
  ],
  "additionalProperties": false
}
