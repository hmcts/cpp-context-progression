<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>uk.gov.moj.cpp.common</groupId>
        <artifactId>service-parent-pom</artifactId>
        <version>25.104.2</version>
    </parent>


    <groupId>uk.gov.moj.cpp.progression</groupId>
    <artifactId>progression-parent</artifactId>
    <version>25.104.0-M1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Progression services application</name>
    <description>A applications for progression service</description>

    <modules>
        <module>progression-query</module>
        <module>progression-viewstore</module>
        <module>progression-command</module>
        <module>progression-event</module>
        <module>progression-eventprocessorstore</module>
        <module>progression-domain</module>
        <module>progression-integration-test</module>
        <module>progression-performance-test</module>
        <module>progression-service</module>
        <module>progression-test-utilities</module>
        <module>progression-refdata-service</module>
        <module>progression-event-sources</module>
        <module>progression-healthchecks</module>
    </modules>

    <properties>
        <!--
          OVERRIDE: this belongs in cpp-platform-maven-common-bom, which declares
          <lombok.version>1.18.26</lombok.version> (see its pom.xml, currently line 128, feeding the
          org.projectlombok:lombok entry in dependencyManagement). It is overridden here rather than
          fixed centrally to avoid re-releasing the platform chain and rebuilding every context image
          for one property. Replace that value with 1.18.40 and delete this override when the BOM is
          next released. cpp-platform-maven-parent-pom carries the same stale number as
          org.projectlombok.version, which cpp-context-work-management-proxy reads.

          Why it cannot stay at 1.18.26: that release predates Java 25 and generates nothing at all
          on this JDK - no getters, no builders, no log field - without reporting an error. The
          module then fails with well over a hundred "cannot find symbol" errors that point nowhere
          near the cause. 1.18.40 is the version sjp and work-management-proxy already override to on
          this same stack.

          Lombok also has to be listed in the compiler plugin's annotationProcessorPaths: since JDK
          23 a provided-scope dependency alone is not discovered and is silently never invoked. See
          progression-event-processor, the only module here that uses it.
        -->
        <lombok.version>1.18.40</lombok.version>
        <sonar.jacoco.itReportPath>${project.basedir}/../target/jacoco-it.exec
        </sonar.jacoco.itReportPath>
        <sonar.report.export.path>sonar-report.json</sonar.report.export.path>
        <sonar.scm.provider>git</sonar.scm.provider>
        <sonar.exclusions>
            **/uk/gov/moj/cpp/progression/domain/**/*,
            **/uk/gov/moj/cpp/progression/command/enforcement/**/*,
            **/uk/gov/moj/cpp/progression/command/defendant/**/*,
            **/uk/gov/moj/cpp/progression/test/**/*,
            **/uk/gov/moj/cpp/progression/test/matchers/**/*,
            **/uk/gov/moj/cpp/progression/CreateJsonSampleUtil.java,
            **/uk/gov/moj/cpp/progression/query/view/response/nowresponse/**/*,
            **/uk/gov/moj/cpp/progression/query/view/response/**/*,
            **/query/view/progression/ctl/model/**/*,
            **/uk/gov/moj/cpp/progression/event/nows/order/**/*,
            **/uk/gov/moj/cpp/progression/persistence/entity/**/*,
            **/uk/gov/moj/cpp/prosecutioncase/persistence/entity/**/*,
            **/uk/gov/moj/cpp/progression/processor/exceptions/**/*,
            **/uk/gov/moj/cpp/progression/service/pojo/**/*,
            **/uk/gov/moj/cpp/progression/service/dto/**/*,
            **/uk/gov/moj/cpp/progression/service/payloads/**/*,
            **/uk/gov/justice/api/resource/utils/payload/UserGroupDetails.java,
            **/uk/gov/moj/cpp/progression/service/ApplicationParameters.java,
            **/uk/gov/justice/services/domain/CaseDocuments.java,
            **/uk/gov/moj/cpp/progression/value/object/**/*
        </sonar.exclusions>
        <resteasy-multipart-provider.version>3.0.7.Final</resteasy-multipart-provider.version>
        <mvn.site.url>file://${project.build.directory}/site</mvn.site.url>
        <javafaker.version>1.0.2</javafaker.version>
        <material.version>17.0.75</material.version>
        <json-transformer.version>25.104.3</json-transformer.version>
        <access.control.version>6.4.1</access.control.version>
        <referencedata.version>17.104.137</referencedata.version>
        <listing.version>17.104.10</listing.version>
        <!-- listing's schemas-only contract artifact, used to generate progression's own
             view of the listing hearing model instead of compiling against listing-common. -->
        <listing.json.version>17.104.8</listing.json.version>
        <hearing.version>17.104.200</hearing.version>
        <usersgroups.version>17.104.50</usersgroups.version>
        <defence.version>17.104.102</defence.version>
        <referencedata.offence.version>17.104.52</referencedata.offence.version>
        <coredomain.version>25.104.2</coredomain.version>
        <directionsmanagement.version>8.0.30</directionsmanagement.version>
        <elasticsearch-maven-plugin.version>6.13</elasticsearch-maven-plugin.version>
        <results.version>17.104.116</results.version>
        <notification.notify.version>17.104.44</notification.notify.version>
        <unifiedsearch.version>17.0.26</unifiedsearch.version>
        <systemdocgenerator.version>17.104.114</systemdocgenerator.version>
        <applicationscourtorders.version>17.0.70</applicationscourtorders.version>
        <sjp.version>17.104.193</sjp.version>
        <httpmime.version>4.5.1</httpmime.version>
        <stagingpubhub.version>17.0.29</stagingpubhub.version>
        <pdfbox.version>2.0.11</pdfbox.version>
        <correspondence.version>17.0.59</correspondence.version>
        <stream-transformation.version>7.0.0</stream-transformation.version>
        <stream-transformation-tool.version>6.4.5</stream-transformation-tool.version>

        <mireportdata-cc-dependency>1.0.48</mireportdata-cc-dependency>
        <dbunit-maven-plugin.version>1.0-beta-3</dbunit-maven-plugin.version>
        <jmeter-maven-plugin.version>1.10.1</jmeter-maven-plugin.version>
        <jmeter-plugins-standard.version>1.3.1</jmeter-plugins-standard.version>
        <jmeter-lightning-maven-plugin>0.1.1</jmeter-lightning-maven-plugin>
        <powermock-reflect>2.0.2</powermock-reflect>
        <podam>7.1.0.RELEASE</podam>
        <jgitflow.maven.developBranchName>main</jgitflow.maven.developBranchName>
        <liquibase.core.version>3.6.1</liquibase.core.version>
        <commons-text.version>1.10.0</commons-text.version>
    </properties>
    <build>
        <plugins>
            <plugin>
